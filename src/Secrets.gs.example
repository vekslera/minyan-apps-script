// ======================================================================================
//  PRIVATE SETTINGS — copy this file to Secrets.gs and fill in your own values.
//
//  Secrets.gs is listed in .gitignore, so it never goes into git, but `clasp push` does upload it,
//  and the script reads it at run time. (This .example file is neither pushed nor read.)
//
//  Only values set once by whoever installs the project live here. Everything the gabbai may change — the
//  gabbai code, the shul's location, radius and GPS tolerance, hours, period, threshold, name — is set on the
//  gabbai tools page or in the הגדרות sheet (the code is kept hidden, in the script's properties).
//
//  Every value is optional.
// ======================================================================================

const SECRETS = {
  // The Google account that owns the Sheet and runs the page. setup() warns if you run it from another account.
  ownerAccount: '',          // e.g. 'minyan.example@gmail.com'

  // Deploy → Manage deployments → the web-app deployment → "Deployment ID" (starts with AKfycb…).
  // The registration page address (else the one pasted in מניין → כתובת דף הרישום (הדבקה));
  // deploy/deploy.ps1 / deploy.sh use it to update the page when deploy/minyanim.json doesn't list this minyan.
  // Empty = the address Google reports for the script (works, but set it to be sure).
  deploymentId: '',

  // RESERVED, not implemented yet: a log of location checks (outcomes only, never coordinates) for
  // investigating poor readings. Has no effect today.
  locationLog: false,

  // The secret part of the registration link (?k=…). Empty = a random key kept in the script's properties.
  // Set it only if you want the link to stay the same after copying the project to a new Sheet.
  kioskKey: '',
};
